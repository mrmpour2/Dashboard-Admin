# این فایل را کپی کرده و به .env تغییر نام دهید، سپس مقادیر واقعی را جایگزین کنید.
# هرگز فایل .env واقعی را وارد گیت نکنید (در .gitignore قرار دارد).

NODE_ENV=development
PORT=5000

# آدرس اتصال به PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dashboard_db?schema=public"

# آدرس فرانت‌اند مجاز برای CORS (چند مورد را با کاما جدا کنید)
CORS_ORIGIN=http://localhost:5174

# رمزهای JWT — حتماً برای production یک مقدار تصادفی و طولانی (حداقل 64 کاراکتر) بسازید
# می‌توانید با دستور زیر یک مقدار امن تولید کنید:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# مدت اعتبار توکن‌ها
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# نام کوکی refresh token
REFRESH_COOKIE_NAME=refresh_token

# تعداد دورهای هش bcrypt (هرچه بیشتر، امن‌تر ولی کندتر)
BCRYPT_SALT_ROUNDS=12

# ثبت‌نام عمومی را در production خاموش نگه دارید
ENABLE_PUBLIC_REGISTRATION=false


# هوش مصنوعی؛ برای سرویس سازگار با OpenAI می‌توانید Base URL را تغییر دهید.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# تنظیمات قابل تغییر فروشگاه
STORE_NAME=فروشگاه شما
STORE_ADDRESS=آدرس فروشگاه را وارد کنید
STORE_HOURS=ساعات کاری را وارد کنید
SHIPPING_POLICY=شرایط ارسال را وارد کنید
RETURN_POLICY=شرایط مرجوعی را وارد کنید
SUPPORT_PHONE=

# زیبال: کلید پذیرنده را فقط در بک‌اند قرار دهید
ZIBAL_MERCHANT=
ZIBAL_API_BASE_URL=https://gateway.zibal.ir/v1
PUBLIC_API_BASE_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5174

# کارت‌به‌کارت؛ این اطلاعات به مشتری نمایش داده می‌شود
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_OWNER=
CARD_TO_CARD_BANK=
CHAT_RECEIPTS_DIR=uploads/chat-receipts
