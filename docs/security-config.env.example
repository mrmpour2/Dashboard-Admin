# Unconnected providers fail closed. Mocks are prohibited in production.
SECURITY_PROVIDER_MODE=disabled
# Server-only Turnstile secret. Set VITE_TURNSTILE_SITE_KEY separately at website build time.
# Mock mode never contacts Turnstile, even when a secret is configured.
TURNSTILE_SECRET_KEY=
# Separate 32+ character HMAC secret; changing this requires hash/backfill planning.
OTP_HASH_SECRET=
OTP_DAILY_PHONE_LIMIT=10
OTP_DAILY_IP_LIMIT=50
STOCK_ONLINE_TTL_SECONDS=900
STOCK_WALLET_TTL_SECONDS=300
# Start closed; after dry-run/backfill use 10, then 100 after independent review.
STOCK_ROLLOUT_PERCENT=0
STOCK_JOB_DRY_RUN=true
# Explicitly list the reverse proxy network. Never trust arbitrary internet clients.
TRUSTED_PROXY=loopback
